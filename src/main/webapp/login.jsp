<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %> <!DOCTYPE html> <html lang="fr"> <head> <meta charset="UTF-8"> <title>Connexion - Télé-Expertise</title> <style> * { box-sizing: border-box; margin: 0; padding: 0; font-family: Arial, sans-serif; } body { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at 15% 20%, rgba(59,130,246,0.25), transparent 30%), radial-gradient(circle at 85% 80%, rgba(139,92,246,0.25), transparent 30%), linear-gradient(135deg, #eef6ff, #f8f5ff); overflow: hidden; } .circle { position: absolute; border-radius: 50%; } .circle-blue { width: 220px; height: 220px; background: rgba(59,130,246,0.12); top: -70px; left: -60px; } .circle-purple { width: 280px; height: 280px; background: rgba(139,92,246,0.12); bottom: -100px; right: -80px; } .login-container { width: 420px; max-width: 90%; position: relative; z-index: 2; } .brand { text-align: center; margin-bottom: 25px; } .brand-icon { width: 65px; height: 65px; margin: 0 auto 12px; display: flex; align-items: center; justify-content: center; border-radius: 20px; background: linear-gradient(135deg, #2563eb, #7c3aed); color: white; font-size: 30px; box-shadow: 0 12px 30px rgba(37,99,235,0.25); } .brand h1 { font-size: 25px; color: #172033; margin-bottom: 5px; } .brand p { color: #64748b; font-size: 14px; } .login-card { background: rgba(255,255,255,0.75); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); border: 1px solid rgba(255,255,255,0.8); border-radius: 24px; padding: 35px; box-shadow: 0 25px 60px rgba(30,41,59,0.12); } .login-card h2 { color: #172033; font-size: 22px; margin-bottom: 7px; } .subtitle { color: #64748b; font-size: 14px; margin-bottom: 28px; } .form-group { margin-bottom: 20px; } .form-group label { display: block; color: #334155; font-size: 14px; font-weight: bold; margin-bottom: 8px; } .input-wrapper { position: relative; } .input-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-size: 17px; } .input-wrapper input { width: 100%; padding: 14px 14px 14px 43px; border: 1px solid #dbe3ef; border-radius: 12px; background: rgba(255,255,255,0.9); font-size: 14px; outline: none; transition: 0.3s; } .input-wrapper input:focus { border-color: #3b82f6; box-shadow: 0 0 0 4px rgba(59,130,246,0.10); } .login-button { width: 100%; border: none; padding: 14px; border-radius: 12px; background: linear-gradient(135deg, #2563eb, #7c3aed); color: white; font-size: 15px; font-weight: bold; cursor: pointer; box-shadow: 0 10px 22px rgba(37,99,235,0.20); transition: 0.3s; } .login-button:hover { transform: translateY(-2px); box-shadow: 0 14px 28px rgba(37,99,235,0.28); } .error { margin-top: 18px; padding: 11px 14px; border-radius: 10px; background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; font-size: 13px; text-align: center; } .footer { text-align: center; margin-top: 22px; color: #94a3b8; font-size: 12px; } </style> </head> <body> <div class="circle circle-blue"></div> <div class="circle circle-purple"></div> <div class="login-container"> <div class="brand"> <div class="brand-icon"> 🩺 </div> <h1>Télé-Expertise</h1> <p>Plateforme médicale</p> </div> <div class="login-card"> <h2>Bienvenue 👋</h2> <p class="subtitle"> Connectez-vous à votre espace médical </p> <form action="login" method="post"> <div class="form-group"> <label>Email</label> <div class="input-wrapper"> <span class="input-icon">✉️</span> <input type="email" name="email" placeholder="exemple@email.com" required> </div> </div> <div class="form-group"> <label>Mot de passe</label> <div class="input-wrapper"> <span class="input-icon">🔒</span> <input type="password" name="password" placeholder="Votre mot de passe" required> </div> </div> <button type="submit" class="login-button"> Se connecter </button> </form> <c:if test="${not empty error}"> <div class="error"> ${error} </div> </c:if> </div> <div class="footer"> Télé-Expertise © 2026 — Plateforme médicale </div> </div> </body> </html>